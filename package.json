{
  "name": "block-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Craftworld — a blocky 3D voxel world with driving, rideable animals, zombies and multiplayer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "ORIGIN_ALLOWLIST=\"http://localhost:5173,http://127.0.0.1:5173\" ALLOW_ORIGINLESS_WS=1 node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test \"scripts/native/__tests__/*.test.mjs\"",
    "pretest:e2e": "NODE_ENV=development vite build --mode e2e",
    "test:e2e": "playwright test",
    "validate:native-endpoints": "node scripts/native/validate-endpoints.mjs",
    "validate:native-projects": "node scripts/native/validate-projects.mjs",
    "build:native": "node scripts/native/build-native.mjs",
    "sync:native": "node scripts/native/sync-native.mjs",
    "sync:native:ios": "node scripts/native/sync-native.mjs ios",
    "sync:native:android": "node scripts/native/sync-native.mjs android",
    "build:ios": "node scripts/native/build-ios.mjs",
    "build:android": "node scripts/native/build-android.mjs",
    "native:idempotence": "node scripts/native/verify-idempotent.mjs",
    "release:aggregate-evidence": "node scripts/native/aggregate-evidence.mjs",
    "release:gate": "node scripts/native/release-gate.mjs",
    "release:profiling-gate": "node scripts/native/profiling-gate.mjs"
  },
  "comment": "Only the server's runtime deps live in dependencies; client libs are devDependencies because Vite bundles them into dist/ at build time, keeping the production image small.",
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "7.1.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.4.4",
    "@capacitor/core": "7.4.4",
    "@capacitor/ios": "7.4.4",
    "@capacitor/network": "7.0.4",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/screen-orientation": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "fast-check": "4.9.0",
    "jsdom": "27.0.1",
    "postprocessing": "^6.39.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.2",
    "vitest": "4.1.11"
  }
}
