# Port the API server listens on (Dokploy sets this).
PORT=3000

# Supabase — the backend uses the SERVICE ROLE key (server-side only, bypasses RLS).
# Never expose the service key to the browser.
SUPABASE_URL=https://supabase.asikmydeen.com
SUPABASE_SERVICE_ROLE_KEY=

# ── Client endpoint configuration (build-time, immutable at runtime) ─────────
# Packaging target for the client build. "web" (default) serves same-origin and
# derives endpoints from the browser origin when the overrides below are omitted.
# "native" (Capacitor iOS/Android) REQUIRES both overrides below.
# VITE_BUILD_TARGET=web

# Absolute REST API base and multiplayer WebSocket URL. Provide BOTH or NEITHER.
# A production build requires HTTPS + WSS, the WebSocket path must be exactly
# /api/mp, and localhost/loopback is rejected. A web build that omits both
# resolves against the current browser origin.
# VITE_API_BASE_URL=https://block-game.asikmydeen.com
# VITE_WEBSOCKET_URL=wss://block-game.asikmydeen.com/api/mp
